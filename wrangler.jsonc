{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentmail",
  "main": "dist/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js"]
    }
  ],
  "build": {
    "command": "deno run -A scripts/buildWorker.ts"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "theagentmail.net",
      "custom_domain": true
    },
    {
      "pattern": "www.theagentmail.net",
      "custom_domain": true
    },
    {
      "pattern": "api.theagentmail.net",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
